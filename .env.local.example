# Credenciais TURN gratuitas do Open Relay Project (via metered.ca).
#
# Sem isso configurado, o app funciona só com STUN — ótimo para a maioria
# das redes, mas pode falhar quando alguém está atrás de um NAT/firewall
# mais restritivo (ex: cada amigo numa rede/operadora diferente).
#
# Como conseguir (grátis, ~2 min):
# 1. Crie uma conta em https://dashboard.metered.ca/signup
# 2. No painel, vá em "Turn Server" / "Open Relay"
# 3. Copie o "App Name" e a "API Key" e cole abaixo
#
# Depois de preencher, copie este arquivo para `.env.local` e reinicie o
# `npm run dev` (variáveis NEXT_PUBLIC_* só são lidas no build/start).

NEXT_PUBLIC_METERED_APP_NAME=
NEXT_PUBLIC_METERED_API_KEY=
